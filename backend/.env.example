# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://username:password@localhost:5432/crm_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm_db

# Backend API Base URL
API_BASE_URL=http://localhost:8000

# Optional: LLM Provider API Key (Optional for future generative enrichment; core ML system does NOT require an LLM)
LLM_API_KEY=
